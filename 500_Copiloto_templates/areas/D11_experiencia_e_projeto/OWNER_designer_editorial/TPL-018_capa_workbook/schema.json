{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:executar:copiloto:template:TPL-018:v1",
  "title": "TPL-018_capa_workbook",
  "description": "Capa modular do workbook com identificação e controle editorial.",
  "type": "object",
  "properties": {
    "registro_id": {
      "type": "string",
      "description": "Identificador único da linha dentro do template."
    },
    "template_id": {
      "type": "string",
      "description": "ID canônico do template."
    },
    "area_id": {
      "type": "string",
      "description": "ID da área do catálogo do ecossistema.",
      "enum": [
        "D01",
        "D02",
        "D03",
        "D04",
        "D05",
        "D06",
        "D07",
        "D08",
        "D09",
        "D10",
        "D11",
        "D12",
        "D13",
        "D14",
        "D15",
        "D16"
      ]
    },
    "owner_papel": {
      "type": "string",
      "description": "Papel funcional sugerido, não identifica pessoa."
    },
    "owner_pessoa": {
      "type": "string",
      "description": "Nome da pessoa responsável (não definido na fonte)."
    },
    "status": {
      "type": "string",
      "description": "Estado do registro. Referencia não significa trabalho concluído.",
      "enum": [
        "rascunho",
        "em_revisao",
        "aprovado",
        "referencia",
        "arquivado"
      ]
    },
    "secao_origem": {
      "type": "string",
      "description": "Seção documental que deu origem ao registro."
    },
    "evidencia_ref": {
      "type": "string",
      "description": "URI ou ID de evidência validada, se houver."
    },
    "capa_id": {
      "type": "string",
      "description": ""
    },
    "titulo": {
      "type": "string",
      "description": ""
    },
    "subtitulo": {
      "type": "string",
      "description": ""
    },
    "linha_apoio": {
      "type": "string",
      "description": ""
    },
    "autor": {
      "type": "string",
      "description": ""
    },
    "versao_documento": {
      "type": "string",
      "description": ""
    },
    "data_emissao": {
      "type": "string",
      "description": ""
    },
    "identidade_visual_ref": {
      "type": "string",
      "description": ""
    },
    "dimensao_pagina": {
      "type": "string",
      "description": ""
    }
  },
  "required": [
    "registro_id",
    "template_id",
    "area_id",
    "owner_papel",
    "status",
    "capa_id",
    "titulo"
  ],
  "additionalProperties": false
}
