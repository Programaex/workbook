{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Front matter de project/epic/issue/subissue/gate",
  "type": "object",
  "required": [
    "id",
    "type",
    "owner",
    "area",
    "title",
    "status",
    "github_url",
    "github_number",
    "owner_path",
    "workbook_path",
    "assignees"
  ],
  "properties": {
    "id": {
      "$ref": "ids.schema.json#/definitions/tarefa"
    },
    "type": {
      "enum": [
        "project",
        "epic",
        "issue",
        "subissue",
        "gate"
      ]
    },
    "parent": {
      "type": "string"
    },
    "owner": {
      "$ref": "ids.schema.json#/definitions/owner_qualquer"
    },
    "area": {
      "$ref": "ids.schema.json#/definitions/area"
    },
    "status": {
      "enum": [
        "backlog",
        "todo",
        "doing",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "github_url": {
      "type": "string",
      "pattern": "^https://github.com/"
    },
    "github_number": {
      "type": "integer",
      "minimum": 1
    },
    "owner_path": {
      "type": "string"
    },
    "workbook_path": {
      "type": "string"
    },
    "co_owners": {
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/owner"
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/area"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "macroarea_id": {
      "$ref": "ids.schema.json#/definitions/macroarea"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(tipo|owner|co|macro):"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "issue",
              "subissue",
              "gate"
            ]
          }
        }
      },
      "then": {
        "required": [
          "parent"
        ],
        "properties": {
          "parent": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
