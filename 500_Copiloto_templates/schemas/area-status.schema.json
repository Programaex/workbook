{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linha de COMPLETUDE.csv",
  "type": "object",
  "properties": {
    "workbook_id": {
      "$ref": "ids.schema.json#/definitions/workbook"
    },
    "completude_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "estado": {
      "enum": [
        "nao_iniciado",
        "em_andamento",
        "em_revisao",
        "concluido"
      ]
    }
  }
}
